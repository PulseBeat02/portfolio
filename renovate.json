{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeAll",
    ":automergeDigest"
  ],
  "configMigration": true,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "Stay on 6.x."
    }
  ]
}
